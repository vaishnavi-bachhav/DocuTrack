@DocuTrack.Api_HostAddress = http://localhost:5257

# -------------------------------------------------------------------
# Replace these values after running the relevant requests.
# Visual Studio/Rider HTTP files do not automatically persist response
# values unless you add response handlers. Copy tokens and IDs manually.
# -------------------------------------------------------------------

@EmployeeToken = REPLACE-WITH-EMPLOYEE-JWT
@ReviewerToken = REPLACE-WITH-REVIEWER-JWT
@AdminToken = REPLACE-WITH-ADMIN-JWT

@MissingId = 11111111-1111-1111-1111-111111111111

@DraftId = REPLACE-WITH-DRAFT-ID
@DraftVersion = 1

@UploadedId = REPLACE-WITH-UPLOADED-ID
@UploadedVersion = 2

@UnderReviewId = REPLACE-WITH-UNDER-REVIEW-ID
@UnderReviewVersion = 3

@PendingApprovalId = REPLACE-WITH-PENDING-APPROVAL-ID
@PendingApprovalVersion = 4

@ApprovedId = REPLACE-WITH-APPROVED-ID
@ApprovedVersion = 5

@RejectedId = REPLACE-WITH-REJECTED-ID
@RejectedVersion = 5

@ArchivedId = REPLACE-WITH-ARCHIVED-ID
@ArchivedVersion = 6


### =========================================================
### AUTHENTICATION
### =========================================================


### Register employee
### Expected: 201 Created
POST {{DocuTrack.Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "fullName": "Test Employee",
  "email": "employee@doctrack.com",
  "password": "Employee@123"
}

###


### Duplicate employee registration
### Expected: 409 Conflict
POST {{DocuTrack.Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "fullName": "Test Employee",
  "email": "employee@doctrack.com",
  "password": "Employee@123"
}

###


### Register with weak password
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/auth/register
Content-Type: application/json
Accept: application/json

{
  "fullName": "Weak Password User",
  "email": "weak@doctrack.com",
  "password": "weak"
}

###


### Valid employee login
### Expected: 200 OK
### Copy accessToken into @EmployeeToken
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "Employee@123"
}

###


### Incorrect password
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### Unknown email
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "missing@doctrack.com",
  "password": "Employee@123"
}

###


### Lockout attempt 1
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### Lockout attempt 2
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### Lockout attempt 3
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### Lockout attempt 4
### Expected: 401 Unauthorized
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### Lockout attempt 5
### Expected: 423 Locked
POST {{DocuTrack.Api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "employee@doctrack.com",
  "password": "WrongPassword@123"
}

###


### =========================================================
### AUTHORIZATION CHECKS
### =========================================================


### Anonymous document request
### Expected: 401 Unauthorized
GET {{DocuTrack.Api_HostAddress}}/api/documents
Accept: application/json

###


### Employee can read documents
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Employee cannot change document status
### Expected: 403 Forbidden
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded",
  "version": {{DraftVersion}}
}

###


### Employee cannot delete a document
### Expected: 403 Forbidden
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### =========================================================
### CREATE DOCUMENTS
### Employee token required
### =========================================================


### Create valid supplier agreement
### Expected: 201 Created
### Copy returned id into @DraftId and version into @DraftVersion
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Supplier Agreement",
  "description": "Annual supplier agreement",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee"
}

###


### Create second valid document
### Expected: 201 Created
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Quality Inspection Report",
  "description": "Inspection report for production batch",
  "documentType": "QualityReport",
  "department": "QualityAssurance",
  "owner": "John Smith"
}

###


### Create with missing title
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "description": "Missing title test",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee"
}

###


### Create with whitespace title
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "   ",
  "description": "Whitespace title test",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee"
}

###


### Create with missing owner
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Owner Test",
  "description": "Owner was not supplied",
  "documentType": "Contract",
  "department": "Purchasing"
}

###


### Create with whitespace owner
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Whitespace Owner Test",
  "description": "Owner contains only whitespace",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "   "
}

###


### Create with unknown document type
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Unknown Type Test",
  "description": "Unknown document type",
  "documentType": "Unknown",
  "department": "Purchasing",
  "owner": "Test Employee"
}

###


### Create with unknown department
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Unknown Department Test",
  "description": "Unknown department",
  "documentType": "Contract",
  "department": "Unknown",
  "owner": "Test Employee"
}

###


### Create with invalid enum text
### Expected: 400 Bad Request
POST {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Invalid Enum Test",
  "description": "Invalid enum text",
  "documentType": "NotAType",
  "department": "Purchasing",
  "owner": "Test Employee"
}

###


### =========================================================
### SEARCH, FILTERING, SORTING AND PAGINATION
### Employee token required
### =========================================================


### Default search
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Page 1 with custom size
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageNumber=1&pageSize=5
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Page 2
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageNumber=2&pageSize=5
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Text search
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?search=supplier
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Search by document number
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?search=DOC-000001
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Owner filter
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?owner=Test
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Status filter
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?status=Draft
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Department filter
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?department=Purchasing
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Combined status and department
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?status=Draft&department=Purchasing
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Created-from filter
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?createdFrom=2026-01-01T00:00:00Z
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Created-to filter
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?createdTo=2026-12-31T23:59:59Z
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Created date range
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?createdFrom=2026-01-01T00:00:00Z&createdTo=2026-12-31T23:59:59Z
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by title ascending
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=Title&sortDirection=Ascending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by title descending
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=Title&sortDirection=Descending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by document number
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=DocumentNumber&sortDirection=Ascending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by owner
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=Owner&sortDirection=Ascending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by status
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=Status&sortDirection=Ascending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Sort by last updated date
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?sortBy=LastUpdatedAt&sortDirection=Descending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Combined search, filter, sort and pagination
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents?search=supplier&status=Draft&department=Purchasing&owner=Test&pageNumber=1&pageSize=10&sortBy=CreatedAt&sortDirection=Descending
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Search with no matches
### Expected: 200 OK with empty items and totalCount = 0
GET {{DocuTrack.Api_HostAddress}}/api/documents?search=definitely-does-not-exist
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid page number
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageNumber=0
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid negative page number
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageNumber=-1
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid page size: zero
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageSize=0
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid page size: greater than 100
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?pageSize=101
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid date range
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?createdFrom=2026-12-31T00:00:00Z&createdTo=2026-01-01T00:00:00Z
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Unknown status filter
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?status=Unknown
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Unknown department filter
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?department=Unknown
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Invalid enum text
### Expected: 400 Bad Request
GET {{DocuTrack.Api_HostAddress}}/api/documents?status=NotAStatus
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### =========================================================
### GET BY ID
### =========================================================


### Get existing document
### Expected: 200 OK
GET {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### Get missing document
### Expected: 404 Not Found
GET {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}
Authorization: Bearer {{EmployeeToken}}
Accept: application/json

###


### =========================================================
### UPDATE DOCUMENT
### Employee token required
### Current version is required for optimistic concurrency
### =========================================================


### Update valid document
### Expected: 200 OK
### Returned version should be current version + 1
PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated Supplier Agreement",
  "description": "Updated annual supplier agreement",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee",
  "version": {{DraftVersion}}
}

###


### Update missing document
### Expected: 404 Not Found
PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Document",
  "description": "This document does not exist",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee",
  "version": 1
}

###


### Update with whitespace owner
### Expected: 400 Bad Request
PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Valid Title",
  "description": "Invalid owner test",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "   ",
  "version": {{DraftVersion}}
}

###


### Update with invalid version
### Expected: 400 Bad Request
PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Valid Title",
  "description": "Invalid version test",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee",
  "version": 0
}

###


### Update with stale version
### Expected: 409 Conflict
### First perform a successful update, then repeat using the old version.
PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{EmployeeToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Stale Update",
  "description": "Client is sending an old version",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Test Employee",
  "version": 1
}

###


### =========================================================
### STATUS WORKFLOW
### Reviewer or Admin token required
### Each request must send the document's current version
### =========================================================


### Draft to Uploaded
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded",
  "version": {{DraftVersion}}
}

###


### Uploaded to UnderReview
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{UploadedId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "UnderReview",
  "version": {{UploadedVersion}}
}

###


### UnderReview to PendingApproval
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{UnderReviewId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "PendingApproval",
  "version": {{UnderReviewVersion}}
}

###


### PendingApproval to Approved
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{PendingApprovalId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved",
  "version": {{PendingApprovalVersion}}
}

###


### PendingApproval to Rejected
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{PendingApprovalId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Rejected",
  "version": {{PendingApprovalVersion}}
}

###


### Rejected to Draft
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{RejectedId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Draft",
  "version": {{RejectedVersion}}
}

###


### Approved to Archived
### Expected: 200 OK
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{ApprovedId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Archived",
  "version": {{ApprovedVersion}}
}

###


### Invalid transition: Draft to Approved
### Expected: 409 Conflict
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved",
  "version": {{DraftVersion}}
}

###


### Unknown new status
### Expected: 400 Bad Request
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Unknown",
  "version": {{DraftVersion}}
}

###


### Invalid status version
### Expected: 400 Bad Request
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded",
  "version": 0
}

###


### Status change for missing document
### Expected: 404 Not Found
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded",
  "version": 1
}

###


### Status change with stale version
### Expected: 409 Conflict
PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{UploadedId}}/status
Authorization: Bearer {{ReviewerToken}}
Content-Type: application/json
Accept: application/json

{
  "newStatus": "UnderReview",
  "version": 1
}

###


### =========================================================
### DELETE DOCUMENT
### Admin token required
### =========================================================


### Delete Draft document
### Expected: 204 No Content
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

###


### Delete Rejected document
### Expected: 204 No Content
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{RejectedId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

###


### Delete Approved document
### Expected: 409 Conflict
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{ApprovedId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

###


### Delete Archived document
### Expected: 409 Conflict
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{ArchivedId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

###


### Delete missing document
### Expected: 404 Not Found
DELETE {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}
Authorization: Bearer {{AdminToken}}
Accept: application/json

###
