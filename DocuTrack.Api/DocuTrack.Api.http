### =========================================================

DELETE {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-REJECTED-DOCUMENT-ID
Accept: application/json

###

### =========================================================
### DELETE AN APPROVED DOCUMENT
### Replace with an existing Approved document ID.
### Expected: 409 Conflict
### =========================================================

DELETE {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-APPROVED-DOCUMENT-ID
Accept: application/json

###

### =========================================================
### DELETE AN ARCHIVED DOCUMENT
### Expected: 409 Conflict
### =========================================================

DELETE {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-ARCHIVED-DOCUMENT-ID
Accept: application/json

###

### =========================================================
### DELETE A MISSING DOCUMENT
### Expected: 404 Not Found
### =========================================================

DELETE {{DocuTrack.Api_HostAddress}}/api/documents/11111111-1111-1111-1111-111111111111
Accept: application/json

