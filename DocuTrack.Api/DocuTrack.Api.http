@DocuTrack.Api_HostAddress = http://localhost:5257

### =========================================================
### GET ALL DOCUMENTS
### Expected: 200 OK
### =========================================================

GET {{DocuTrack.Api_HostAddress}}/api/documents
Accept: application/json

###

### =========================================================
### CREATE A VALID DOCUMENT
### Expected: 201 Created
### Copy the returned ID for later requests.
### =========================================================

POST {{DocuTrack.Api_HostAddress}}/api/documents
Content-Type: application/json
Accept: application/json

{
  "title": "Supplier Agreement",
  "description": "Annual supplier agreement",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Vaishnavi Bachhav"
}

###

### =========================================================
### CREATE A SECOND DOCUMENT
### Expected: 201 Created
### =========================================================

POST {{DocuTrack.Api_HostAddress}}/api/documents
Content-Type: application/json
Accept: application/json

{
  "title": "Quality Inspection Report",
  "description": "Final inspection report for production batch 2026-07",
  "documentType": "QualityReport",
  "department": "QualityAssurance",
  "owner": "John Smith"
}

###

### =========================================================
### GET DOCUMENT BY ID
### Replace the GUID with an existing document ID.
### Expected: 200 OK
### =========================================================

GET {{DocuTrack.Api_HostAddress}}/api/documents/ff45625d-06ee-4b74-9a9c-284fffaa3735
Accept: application/json

###

### =========================================================
### GET MISSING DOCUMENT
### Expected: 404 Not Found
### =========================================================

GET {{DocuTrack.Api_HostAddress}}/api/documents/11111111-1111-1111-1111-111111111111
Accept: application/json

###

### =========================================================
### UPDATE DOCUMENT METADATA
### Replace the GUID with an existing document ID.
### Expected: 200 OK
### Version should increase.
### DocumentNumber and CreatedDate should not change.
### =========================================================

PUT {{DocuTrack.Api_HostAddress}}/api/documents/fc46eb5b-4c3a-4d78-8839-16f27b5c5128
Content-Type: application/json
Accept: application/json

{
  "title": "Updated Supplier Agreement",
  "description": "Updated annual supplier agreement",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Vaishnavi Bachhav"
}

###

### =========================================================
### UPDATE MISSING DOCUMENT
### Expected: 404 Not Found
### =========================================================

PUT {{DocuTrack.Api_HostAddress}}/api/documents/11111111-1111-1111-1111-111111111111
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Document Update",
  "description": "This document does not exist",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Vaishnavi Bachhav"
}

###

### =========================================================
### VALID STATUS TRANSITION: DRAFT -> UPLOADED
### Replace the GUID with a Draft document ID.
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/fc46eb5b-4c3a-4d78-8839-16f27b5c5128/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded"
}

###

### =========================================================
### VALID STATUS TRANSITION: UPLOADED -> UNDER REVIEW
### Use the same document after changing it to Uploaded.
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/fc46eb5b-4c3a-4d78-8839-16f27b5c5128/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "UnderReview"
}

###

### =========================================================
### VALID STATUS TRANSITION: UNDER REVIEW -> PENDING APPROVAL
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/fc46eb5b-4c3a-4d78-8839-16f27b5c5128/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "PendingApproval"
}

###

### =========================================================
### VALID STATUS TRANSITION: PENDING APPROVAL -> APPROVED
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/fc46eb5b-4c3a-4d78-8839-16f27b5c5128/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved"
}

###

### =========================================================
### VALID STATUS TRANSITION: PENDING APPROVAL -> REJECTED
### Use a separate PendingApproval document.
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DOCUMENT-ID/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Rejected"
}

###

### =========================================================
### VALID STATUS TRANSITION: REJECTED -> DRAFT
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DOCUMENT-ID/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Draft"
}

###

### =========================================================
### VALID STATUS TRANSITION: APPROVED -> ARCHIVED
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DOCUMENT-ID/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Archived"
}

###

### =========================================================
### INVALID STATUS TRANSITION: DRAFT -> APPROVED
### Use a Draft document.
### Expected: 409 Conflict
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DOCUMENT-ID/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved"
}

###

### =========================================================
### INVALID STATUS: UNKNOWN
### Expected: 400 Bad Request
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DOCUMENT-ID/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Unknown"
}

###

### =========================================================
### CHANGE STATUS FOR MISSING DOCUMENT
### Expected: 404 Not Found
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/11111111-1111-1111-1111-111111111111/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded"
}

###

### =========================================================
### DELETE A DRAFT DOCUMENT
### Replace with an existing Draft document ID.
### Expected: 204 No Content
### =========================================================

DELETE {{DocuTrack.Api_HostAddress}}/api/documents/REPLACE-WITH-DRAFT-DOCUMENT-ID
Accept: application/json

###

### =========================================================
### DELETE A REJECTED DOCUMENT
### Replace with an existing Rejected document ID.
