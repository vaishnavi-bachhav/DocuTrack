Content-Type: application/json
Accept: application/json

{
  "title": "Valid Title",
  "description": "Invalid owner test",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "   "
}

###

### =========================================================
### VALID STATUS TRANSITION: DRAFT TO UPLOADED
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded"
}

###

### =========================================================
### VALID STATUS TRANSITION: UPLOADED TO UNDER REVIEW
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{UploadedId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "UnderReview"
}

###

### =========================================================
### VALID STATUS TRANSITION: PENDING APPROVAL TO APPROVED
### Expected: 200 OK
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{PendingApprovalId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved"
}

###

### =========================================================
### INVALID STATUS TRANSITION
### Example: Draft to Approved
### Tests centralized 409 handling
### Expected: 409 Conflict
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Approved"
}

###

### =========================================================
### UNKNOWN NEW STATUS
### Expected: 400 Bad Request
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Unknown"
}

###

### =========================================================
### CHANGE STATUS FOR MISSING DOCUMENT
### Expected: 404 Not Found
### =========================================================

PATCH {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}/status
Content-Type: application/json
Accept: application/json

{
  "newStatus": "Uploaded"
}

