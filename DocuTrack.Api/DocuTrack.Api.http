### =========================================================
### GET EXISTING DOCUMENT
### Expected: 200 OK
### =========================================================

GET {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Accept: application/json

###

### =========================================================
### GET MISSING DOCUMENT
### Tests centralized DocumentNotFoundException handling
### Expected: 404 Not Found
### =========================================================

GET {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}
Accept: application/json

###

### =========================================================
### UPDATE VALID DOCUMENT
### Expected: 200 OK
### Version should increase
### =========================================================

PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{DraftId}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated Supplier Agreement",
  "description": "Updated annual supplier agreement",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Vaishnavi Bachhav"
}

###

### =========================================================
### UPDATE MISSING DOCUMENT
### Tests centralized 404 handling
### Expected: 404 Not Found
### =========================================================

PUT {{DocuTrack.Api_HostAddress}}/api/documents/{{MissingId}}
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Document",
  "description": "This document does not exist",
  "documentType": "Contract",
  "department": "Purchasing",
  "owner": "Vaishnavi Bachhav"
}

###

